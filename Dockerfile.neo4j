FROM dhi.io/neo4j:5.26-dev AS tools

RUN apt-get update \
    && apt-get install -y --no-install-recommends --reinstall mawk \
    && rm -rf /var/lib/apt/lists/*

FROM dhi.io/neo4j:5.26

USER 0:0

COPY --from=tools /usr/bin/mawk /usr/local/bin/awk
COPY --from=tools /usr/share/doc/mawk/copyright /usr/share/doc/mawk/copyright

RUN chmod -R a+rX /var/lib/neo4j

USER 1069:1069
